{
  "name": "@grindfree/guard",
  "version": "0.1.0",
  "description": "Drop-in x402 guards that screen PromptShield, CrawlSafe, ToolGuard, CommandGuard, MemoryGuard, WireShield and DocShield before an agent acts. Caller wallet only; never embeds keys.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "x402",
    "agents",
    "security",
    "guardrail",
    "toolguard",
    "commandguard",
    "promptshield",
    "mcp",
    "langchain",
    "openai-agents"
  ],
  "license": "MIT",
  "author": "GrindFree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronin93/grindfree-guard.git"
  },
  "homepage": "https://github.com/ronin93/grindfree-guard#readme",
  "bugs": {
    "url": "https://github.com/ronin93/grindfree-guard/issues"
  },
  "dependencies": {
    "@x402/evm": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
